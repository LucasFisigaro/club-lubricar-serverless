# =============================================================================
# SUPABASE CONFIGURATION (Club Lubricar - Serverless)
# =============================================================================
# Copy this file to `.env` for local development (`cp .env.example .env`)
# or add these variables in Cloudflare Pages -> Settings -> Environment Variables.
#
# Note: Only the public `anon` key goes here. Never expose your `service_role` key!
# All data access is strictly protected by Supabase Auth & PostgreSQL RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
